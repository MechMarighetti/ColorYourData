# Copy this file to .env.local and fill with your Supabase credentials

# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=env.local.SUPABASE_URL
SUPABASE_ANON_KEY=env.local.SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=env.local.SUPABASE_SERVICE_KEY

NODE_ENV=development
PORT=3000
