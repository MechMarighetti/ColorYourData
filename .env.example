# Copy this file to .env.local and fill with your Supabase credentials

# Get these from: https://app.supabase.com/project/_/settings/api
CYD_SUPABASE_URL=https://your-project.supabase.co
CYD_SUPABASE_KEY=your-anon-public-key
CYD_SUPABASE_SERVICE_KEY=your-service-role-key

NODE_ENV=development
PORT=3000
